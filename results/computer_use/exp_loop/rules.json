{
  "schema": 1,
  "meta": {
    "n_episodes": 207,
    "n_pos": 103,
    "n_neg": 104,
    "gate": {
      "recall_min": 0.9,
      "fpr_max": 0.05
    }
  },
  "rules": [
    {
      "detector": "no_visual_change",
      "rule_id": "R1_assert_effect",
      "version": 2,
      "status": "active",
      "statement": "动作后必须观测到画面/状态变化；观测不到即判动作未生效，不得采信动作后的读数。",
      "condition": "action.type==click and expected.kind in {selection_change,state_change}",
      "hook": "click_slot_verified / _step_duck",
      "invalidate_if": "界面存在与动作无关的持续动画，使 frame_diff 长期高于阈值",
      "params": {
        "thr": 3.0
      },
      "metrics": {
        "train": {
          "tp": 15,
          "n_pos": 42,
          "fp": 0,
          "n_neg": 28
        },
        "val": {
          "tp": 15,
          "n_pos": 45,
          "fp": 0,
          "n_neg": 28,
          "precision": 1.0,
          "fpr": 0.0,
          "recall": 0.333
        }
      },
      "gate": {
        "fpr_max": 0.05,
        "min_tp": 1
      }
    },
    {
      "detector": "text_unchanged",
      "rule_id": "R2_refetch_after_action",
      "version": 2,
      "status": "active",
      "statement": "禁止把动作前文本当动作后状态：文本未变时必须重新取证（帧+文本），并区分「没生效」与「确实无变化」。",
      "condition": "expected.kind in {selection_change,text_change,state_change}",
      "hook": "read_duck_profile / _page_text",
      "invalidate_if": "动作确实是幂等的（重复执行不产生可观测差异）",
      "params": {},
      "metrics": {
        "train": {
          "tp": 13,
          "n_pos": 42,
          "fp": 2,
          "n_neg": 28
        },
        "val": {
          "tp": 13,
          "n_pos": 45,
          "fp": 1,
          "n_neg": 28,
          "precision": 0.929,
          "fpr": 0.036,
          "recall": 0.289
        }
      },
      "gate": {
        "fpr_max": 0.05,
        "min_tp": 1
      }
    },
    {
      "detector": "empty_recognition",
      "rule_id": "R3_empty_is_not_absent",
      "version": 2,
      "status": "active",
      "statement": "识别返回空串不等于目标不存在：必须回退第二通道（整页识别）后再判，且不得据此得出「无气泡 / 无内容」的结论。",
      "condition": "action.type==recognize and ocr_channel==fast",
      "hook": "ocr_fast",
      "invalidate_if": "存在真实空白区域，回退通道同样为空且能量低",
      "params": {
        "min_energy": 6.0
      },
      "metrics": {
        "train": {
          "tp": 9,
          "n_pos": 9,
          "fp": 0,
          "n_neg": 23
        },
        "val": {
          "tp": 7,
          "n_pos": 7,
          "fp": 0,
          "n_neg": 25,
          "precision": 1.0,
          "fpr": 0.0,
          "recall": 1.0
        }
      },
      "gate": {
        "fpr_max": 0.05,
        "min_tp": 1
      }
    },
    {
      "detector": "target_is_sentence",
      "rule_id": "R4_labels_only",
      "version": 2,
      "status": "proposed",
      "statement": "可点目标必须是短标签（长度 ≤ 阈值）；长句一律视为说明文本，不可点。",
      "condition": "action.type==click and action.text_target != ''",
      "hook": "_find_exact",
      "invalidate_if": "界面把按钮文案写成整句（实测未出现）",
      "params": {
        "max_chars": 6
      },
      "metrics": {
        "train": {
          "tp": 2,
          "n_pos": 2,
          "fp": 0,
          "n_neg": 0
        },
        "val": {
          "tp": 2,
          "n_pos": 2,
          "fp": 0,
          "n_neg": 0,
          "precision": 1.0,
          "fpr": null,
          "recall": 1.0
        }
      },
      "gate": {
        "fpr_max": 0.05,
        "min_tp": 1
      }
    },
    {
      "detector": "click_off_icon",
      "rule_id": "R5_hit_icon_center",
      "version": 2,
      "status": "active",
      "statement": "点击落点必须落在检测到的图标中心容差内，否则视为缝隙，禁止执行。",
      "condition": "action.type==click and 槽位带可见",
      "hook": "_click_icon",
      "invalidate_if": "图标检测本身不可用（检测数为 0）",
      "params": {
        "tol": 0.018
      },
      "metrics": {
        "train": {
          "tp": 13,
          "n_pos": 42,
          "fp": 0,
          "n_neg": 28
        },
        "val": {
          "tp": 14,
          "n_pos": 45,
          "fp": 0,
          "n_neg": 28,
          "precision": 1.0,
          "fpr": 0.0,
          "recall": 0.311
        }
      },
      "gate": {
        "fpr_max": 0.05,
        "min_tp": 1
      }
    }
  ]
}